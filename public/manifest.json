{
  "manifest_version": 3,
  "name": "浏览器工作台",
  "version": "0.1.0",
  "description": "个人工作台新标签页：搜索、快捷跳转、记账、便签、待办、健康与饮食管理",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
